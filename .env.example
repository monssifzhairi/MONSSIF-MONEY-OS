# ─── MONSSIF MONEY OS environment variables ────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#
# LOCAL MODE (default): leave the Supabase values empty.
# The app runs fully offline against browser localStorage — no account needed.
#
# SUPABASE MODE: create a free project at https://supabase.com, run the SQL
# migration in `supabase/migrations/0001_init.sql` via the SQL editor, then
# fill in the two values below (Project Settings → API).
# Only the *anon/public* key belongs here. NEVER put a service_role key in a
# frontend environment variable — it would be exposed in the built bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: seed the local database with sample data on first launch.
# You can also load sample data from Settings at any time.
# VITE_SEED_SAMPLE_DATA=true
